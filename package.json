    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.1.6",
